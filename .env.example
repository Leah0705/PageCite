ENVIRONMENT=local
TOKENIZERS_PARALLELISM=false
STORAGE_DIR=storage
ANONYMIZED_TELEMETRY=false

GOOGLE_API_KEY=your-google-api-key-here
TAVILY_API_KEY=your-tavily-api-key-here

CORS_ORIGINS=http://localhost:3000

# ── Clerk Auth ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ── Postgres ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://pagecite:pagecite@localhost:5432/pagecite

# ── RAG ───────────────────────────────────────────────────────────────────────
CONTEXTUAL_RETRIEVAL=true
CONTEXTUALIZE_WORKERS=8
REDIS_URL=redis://localhost:6379
SEMANTIC_CACHE_THRESHOLD=0.97
CACHE_TTL_SECONDS=86400
HYDE_THRESHOLD=0.3
EXTRACT_FIGURES=true
# TESSERACT_CMD=/usr/local/bin/tesseract

# ── Models (local, via sentence-transformers) ───────────────────────────────────
# Defaults are English models. For Chinese or other languages, switch to the
# multilingual preset below, then reindex every document: vectors from different
# models are not comparable. Both presets produce 768-d vectors, which the schema
# requires. The multilingual models were not benchmarked in this repo, so re-run
# `make eval` and re-check SEMANTIC_CACHE_THRESHOLD (multilingual-e5 cosine scores
# sit between about 0.7 and 1.0) and HYDE_THRESHOLD (compared with raw reranker
# scores) after switching.
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_QUERY_PREFIX=
EMBEDDING_PASSAGE_PREFIX=
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Multilingual preset:
# EMBEDDING_MODEL=intfloat/multilingual-e5-base
# EMBEDDING_QUERY_PREFIX="query: "
# EMBEDDING_PASSAGE_PREFIX="passage: "
# RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# ── Chat memory (Redis) ───────────────────────────────────────────────────────
CHAT_MEMORY_TTL_SECONDS=604800

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_HOUR=30
RATE_LIMIT_PER_DAY=200

# ── PII redaction ─────────────────────────────────────────────────────────────
PII_REDACTION=true
